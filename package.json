{
  "name": "dataset_web",
  "version": "2.2.0",
  "description": "",
  "main": "electron-main.js",
  "scripts": {
    "test": "node --test server/test/*.test.js client/src/utils/*.test.js client/src/editor/core/*.test.js client/src/hooks/*.test.js client/src/components/*.interactions.test.js && npm run verify:no-direct-fetch",
    "test:ui": "npm --prefix client run test:ui",
    "start": "node server/index.js",
    "electron:dev": "concurrently \"npm run client:dev\" \"electron .\"",
    "client:dev": "npm run dev --prefix client",
    "electron:build": "npx npm-run-all --serial verify:build-config test build:client build:electron verify:packaged-output",
    "build:client": "npm run build --prefix client",
    "build:electron": "npx electron-builder",
    "verify:no-direct-fetch": "node scripts/verify-no-direct-fetch.js",
    "verify:build-config": "node scripts/verify-build-config.js",
    "verify:packaged-output": "node scripts/verify-packaged-output.js"
  },
  "build": {
    "appId": "com.pose-annotator.app",
    "productName": "Pose Annotator",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron-main.js",
      "server/**/*",
      "scripts/**/*",
      "package.json",
      "node_modules/**/*",
      "client/dist/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pose Annotator"
    },
    "asar": false
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "adm-zip": "^0.5.16",
    "archiver": "^7.0.1",
    "body-parser": "^2.2.2",
    "core-util-is": "^1.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "image-size": "^2.0.2",
    "inherits": "^2.0.4",
    "isarray": "^2.0.5",
    "multer": "^2.0.2",
    "sharp": "^0.34.5",
    "ssh2": "^1.17.0",
    "winston": "^3.19.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^40.3.0",
    "electron-builder": "^26.7.0",
    "npm-run-all": "^4.1.5",
    "wait-on": "^9.0.3"
  }
}
